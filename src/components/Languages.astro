---
import { siteConfig } from "../config";
const hasLanguages = siteConfig.languages && siteConfig.languages.length > 0;
---

{
  hasLanguages && (
    <section id="languages" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-slate-100">
              Languages
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
              {siteConfig.languages.map((language) => (
                <div class="bg-slate-900 rounded-lg shadow-sm border border-slate-800 p-4 sm:p-5 md:p-6 hover:shadow-md hover:border-slate-700 transition-all duration-300">
                  <h3 class="text-lg sm:text-xl font-semibold text-slate-100">
                    {language.name}
                  </h3>
                  <p
                    class="text-sm sm:text-base mt-1"
                    style={`color: ${siteConfig.accentColor}`}
                  >
                    {language.level}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
